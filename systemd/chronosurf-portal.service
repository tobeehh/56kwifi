[Unit]
Description=Chronosurf Captive Portal
After=network.target dnsmasq.service hostapd.service
Wants=dnsmasq.service hostapd.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/chronosurf/portal
ExecStart=/usr/bin/python3 /opt/chronosurf/portal/app.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
