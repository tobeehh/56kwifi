[Unit]
Description=Chronosurf Captive Portal
After=network.target dnsmasq.service hostapd.service
Wants=dnsmasq.service hostapd.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/chronosurf/portal
ExecStart=/usr/local/bin/gunicorn -w 2 -b 0.0.0.0:8080 --timeout 30 --access-logfile - --error-logfile - app:app
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
