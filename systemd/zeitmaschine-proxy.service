[Unit]
Description=Zeitmaschine Wayback Proxy
After=network.target zeitmaschine-portal.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/zeitmaschine/proxy
ExecStart=/usr/bin/python3 /opt/zeitmaschine/proxy/wayback_proxy.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
